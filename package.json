{
  "name": "shiome-fishing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-mobile.mjs",
    "build:site": "powershell -ExecutionPolicy Bypass -File scripts/build-sites.ps1",
    "build:mobile": "node scripts/build-mobile.mjs",
    "ios:add": "npm run build:mobile && npx cap add ios",
    "ios:sync": "npm run build:mobile && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
