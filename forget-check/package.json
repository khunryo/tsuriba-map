{
  "name": "forget-check",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "ios:add": "pnpm run build:mobile && pnpm exec cap add ios",
    "ios:sync": "pnpm run build:mobile && pnpm exec cap sync ios",
    "ios:open": "pnpm exec cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  }
}
